# Copy to .env for local reference, then set these values in the backend process environment.
# Obtain database host, port and username from Supabase Dashboard > Connect.
SUPABASE_DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=<supabase-database-user>
SUPABASE_DB_PASSWORD=<supabase-database-password>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_STORAGE_BUCKET=complaint-images
SUPABASE_SERVICE_ROLE_KEY=<server-only-supabase-key>

# Generate two independent base64 secrets, each decoding to at least 32 random bytes.
JWT_SECRET_BASE64=<base64-secret-1>
COMPLAINT_TRACKING_SECRET_BASE64=<base64-secret-2>

FRONTEND_ORIGIN=http://localhost:5500
PORT=8080
